---

---

<section
  id="inicio"
  class="relative min-h-svh flex items-center overflow-hidden"
>
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse 80% 60% at 25% 40%, rgba(74,93,78,0.92) 0%, transparent 65%),
                            radial-gradient(ellipse 55% 75% at 80% 65%, rgba(111,78,55,0.65) 0%, transparent 60%),
                            radial-gradient(ellipse 100% 60% at 50% 100%, rgba(25,33,27,0.95) 0%, transparent 55%),
                            linear-gradient(155deg, #1e2820 0%, #4A5D4E 40%, #6F4E37 75%, #2a1c12 100%)"
    >
    </div>
    <div
      class="absolute rounded-full opacity-10 bg-sand"
      style="width:200px;height:200px;top:8%;left:12%;animation:float 9s ease-in-out infinite;"
    >
    </div>
    <div
      class="absolute rounded-full opacity-10 bg-sand"
      style="width:90px;height:90px;top:58%;left:72%;animation:float 7s ease-in-out 2s infinite;"
    >
    </div>
    <div
      class="absolute rounded-full opacity-[0.07] bg-cream"
      style="width:280px;height:280px;top:3%;left:52%;animation:float 11s ease-in-out 4s infinite;"
    >
    </div>
    <div
      class="absolute rounded-full opacity-10 bg-bark-light"
      style="width:60px;height:60px;top:78%;left:18%;animation:float 8s ease-in-out 1s infinite;"
    >
    </div>
  </div>

  <div
    class="max-w-6xl mx-auto px-6 lg:px-16 relative z-10 pt-24 pb-24 text-cream"
  >
    <div
      class="flex items-center gap-3 mb-6"
      style="animation: fadeUp 0.7s 0.2s both;"
    >
      <span class="block w-10 h-px bg-sand opacity-70"></span>
      <span
        class="text-[0.68rem] font-medium tracking-[0.28em] uppercase text-sand"
        >Refugio de montaña</span
      >
      <span class="block w-10 h-px bg-sand opacity-70"></span>
    </div>

    <h1
      class="font-display font-light text-cream leading-none mb-6"
      style="font-size: clamp(3.5rem, 10vw, 7.5rem); animation: fadeUp 0.7s 0.35s both;"
    >
      Highlands<br />
      <em class="italic text-sand-light">Hotel</em>
    </h1>

    <p
      class="text-cream/70 font-light leading-[1.85] mb-10 max-w-lg"
      style="font-size: clamp(0.9rem, 1.5vw, 1rem); animation: fadeUp 0.7s 0.5s both;"
    >
      Un refugio en la montaña donde la naturaleza, el confort y la tranquilidad
      se encuentran.<br />
    </p>
    <div class="border-l-2 border-sand pl-5 mb-10">
      <p
        class="font-display font-light italic text-cream/90"
        style="font-size: clamp(1.1rem, 2vw, 1.35rem);"
      >
        "Donde el descanso se siente<br />y la confianza se vive."
      </p>
    </div>
    <a
      href="#nosotros"
      class="absolute bottom-8 left-1/2 text-cream/40 hover:text-sand transition-colors duration-300 z-10"
      style="transform:translateX(-50%); animation: bounce-y 2.2s ease-in-out infinite;"
      aria-label="Ir a habitaciones"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="M10 4v12M4 10l6 6 6-6"></path>
      </svg>
    </a>
  </div>
</section>
